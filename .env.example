# ---- Required -------------------------------------------------------
GROQ_API_KEY=your_groq_key_here
AGENT_EMAIL=your_gmail_address_here
# Use \n for a line break
AGENT_SIGNATURE=Best regards,\nYour Name

# ---- Optional (defaults shown) --------------------------------------
POLL_INTERVAL_SECONDS=60
# GROQ_MODEL=openai/gpt-oss-120b
# BUSINESS_CONTEXT_FILE=knowledge/business_info.md
# MARK_SKIPPED_AS_READ=false
# MAX_REPLIES_PER_THREAD_PER_HOUR=1
# Only mail newer than this many days is handled (0 = no limit)
# MAX_EMAIL_AGE_DAYS=2

# ---- Cloud / headless (Railway) - see DEPLOYMENT.md -----------------
# GMAIL_TOKEN_JSON_B64=output of: python main.py export-token
# ALLOW_INTERACTIVE_AUTH=false
# AGENT_DATA_DIR=/data
# LOG_TO_FILE=false

# ---- Webhook mode only ----------------------------------------------
# GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic>
# PUBSUB_PUSH_AUDIENCE=https://<your-app>.up.railway.app/gmail-webhook
# PUBSUB_PUSH_SERVICE_ACCOUNT=<push-sa>@<project-id>.iam.gserviceaccount.com
# WEBHOOK_FALLBACK_POLL_SECONDS=600
